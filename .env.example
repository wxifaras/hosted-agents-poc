# Optional local defaults. Copy to .env; never commit credentials.
# No Azure values are required for local environment validation or unit tests.
# ENVIRONMENT, ports, timeout, and log level are local defaults, not deployment outputs.
ENVIRONMENT=development
# Explicit diagnostic opt-in; never relaxes normal workflow ownership checks.
POC_ENABLE_IDENTITY_TESTS=false
# These names match Bicep outputs directly.
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
SUPERVISOR_PORT=8088
RESEARCH_PORT=8089
DATA_ANALYSIS_PORT=8090
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
# Native execution is direct-protocol only and requires verified Hosted owner/session context.
# Baseline rows: 1000,10000,100000; opt-in pressure rows: 250000,500000,1000000.
# No toolbox fallback, automatic replay, caller prompts/code, or native file/container IDs.
STORY1_NATIVE_ENABLED=false
STORY1_NATIVE_PRESSURE_ENABLED=false
STORY1_NATIVE_TIMEOUT_SECONDS=300
STORY1_NATIVE_MAX_OUTPUT_BYTES=52428800

# Dedicated Story6 entrypoint only; never attaches tools to the original three agents.
# Local readiness is available; commands still require verified Foundry caller/session context.
STORY6_ENABLED=false
STORY6_PORT=8091
STORY6_REQUEST_TIMEOUT_SECONDS=60
# Optional positive immutable version of story6-approval-mcp; leave UNSET for public Learn.
# No URL, credentials or arbitrary toolbox names are accepted.
# STORY6_TOOLBOX_VERSION=1
# Instead of toolbox, select the single-tool custom Entra MCP route (both required).
# STORY6_MCP_URL=https://<app>.<environment>.azurecontainerapps.io/mcp
# STORY6_MCP_SCOPE=api://<API-client-ID>/.default
# Tool-service-only settings; do not attach them to the original agent hosts.
# STORY6_MCP_TENANT_ID=<tenant-ID>
# STORY6_MCP_AUDIENCE=<API-client-ID>
# STORY6_MCP_CALLER_ID=<actual-coordinator-principal-object-ID>
# STORY6_MCP_PORT=8092

# Optional Azure App Configuration (local env values override remote values).
# APP_CONFIG_ENDPOINT is a Bicep output; it is empty when the resource is disabled.
APP_CONFIG_ENDPOINT=
APP_CONFIG_KEY_FILTER=hosted-agents-poc:*
APP_CONFIG_LABEL_FILTER=
# Leave blank for local az/azd user login; never copy a Foundry project/agent identity here.
AZURE_CLIENT_ID=

# Optional telemetry. Requires the telemetry extra; content capture stays disabled.
# The generator leaves telemetry unchanged. An optional future lookup can use AZURE_APPLICATION_INSIGHTS_ID.
# Connection strings and credentials are not exported as plain Bicep outputs.
APPLICATIONINSIGHTS_CONNECTION_STRING=
