# Reference only: the Python scripts do not automatically load this file.
# Configure these in the experiment's own azd environment after deployment approval.
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ID=/subscriptions/<subscription>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
STORY13_IMAGE=<registry>.azurecr.io/story13-probe@sha256:<64-character-image-digest>
# Shell-only feature switch for snapshot-enabled deployments.
AZD_ALPHA_ENABLE_AGENTS_MEMORY_SNAPSHOT=true
# Local host default; no model, connection string, or application secret is required.
PORT=8093
